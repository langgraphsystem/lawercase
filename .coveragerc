[run]
source = core, api
omit =
    */migrations/*
    */alembic/*
    */__pycache__/*
    */examples/*
    */scripts/*
    */benchmarks/*
    */tests/*
    */mlops/*
    */.venv/*
    */node_modules/*
    */legal/*
    */knowledge_base/*
    */compliance/*
    */web/*
    */sites/*
    */out/*
    */output/*
    */data/*
    */docker/*
    */infrastructure/*

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    if TYPE_CHECKING:
    if __name__ == .__main__.:
    raise NotImplementedError
    pass
    \.\.\.
show_missing = true
precision = 1
fail_under = 15

[html]
directory = htmlcov
